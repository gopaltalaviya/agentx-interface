{
  "name": "agentx-interface",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "cross-env NEXT_PUBLIC_API_URL=http://127.0.0.1:8787 next build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "check:contract": "node scripts/check-api-contract.mjs"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.26",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.23"
    }
  }
}
